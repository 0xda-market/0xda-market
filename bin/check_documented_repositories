#!/usr/bin/env bash
set -euo pipefail

root="${1:-.}"
organization="${DOCUMENTED_REPOSITORY_OWNER:-0xda-market}"
current_repository="${GITHUB_REPOSITORY:-}"

mapfile -d '' files < <(
  find "$root" -type f \
    \( -name '*.md' -o -name '*.markdown' -o -name '*.yml' -o -name '*.yaml' -o -name '*.json' -o -name '*.toml' -o -name '*.txt' -o -name 'PROJECT_INSTRUCTIONS*' \) \
    -not -path '*/.git/*' \
    -not -path '*/vendor/*' \
    -not -path '*/node_modules/*' \
    -not -path '*/tmp/*' \
    -not -path '*/coverage/*' \
    -print0
)

if (( ${#files[@]} == 0 )); then
  echo "no documentation files found"
  exit 0
fi

mapfile -t documented_urls < <(
  grep -hEo 'https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+' "${files[@]}" \
    | sed -E 's/[.,;:)>\]]+$//' \
    | sort -u
)

if (( ${#documented_urls[@]} == 0 )); then
  echo "no GitHub repository links found"
  exit 0
fi

declare -A renamed_repositories=(
  ['0x0sky/0xda-market']='0xda-market/core'
  ['0x0sky/0xda-market-bot']='0xda-market/telegram-bot'
  ['0xda-market/0xda-market']='0xda-market/core'
  ['0xda-market/0xda-market-bot']='0xda-market/telegram-bot'
)

failed=0
repository_urls=()
for repository_url in "${documented_urls[@]}"; do
  slug="${repository_url#https://github.com/}"
  if [[ -n "${renamed_repositories[$slug]:-}" ]]; then
    echo "stale repository slug: ${slug}; use ${renamed_repositories[$slug]}" >&2
    failed=1
  fi

  if [[ "$slug" == "${organization}/"* ]]; then
    repository_urls+=("$repository_url")
  fi
done

curl_headers=(
  --header 'Accept: application/vnd.github+json'
  --header 'X-GitHub-Api-Version: 2022-11-28'
)
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  curl_headers+=(--header "Authorization: Bearer ${GITHUB_TOKEN}")
fi

for repository_url in "${repository_urls[@]}"; do
  slug="${repository_url#https://github.com/}"
  api_url="https://api.github.com/repos/${slug}"

  if ! status="$({ curl --silent --show-error --output /dev/null --write-out '%{http_code}' "${curl_headers[@]}" "$api_url"; } 2>&1)"; then
    echo "repository check failed: ${repository_url}: ${status}" >&2
    failed=1
    continue
  fi

  if [[ "$status" == '200' ]]; then
    continue
  fi

  # GitHub Actions GITHUB_TOKEN is scoped to the workflow repository. GitHub
  # intentionally reports private sibling repositories as 404 to that token.
  # Keep canonical/stale-slug validation strict, but do not misclassify this
  # authorization boundary as a broken documentation link.
  if [[ "$status" == '404' && -n "${GITHUB_ACTIONS:-}" && -n "$current_repository" && "$slug" != "$current_repository" ]]; then
    echo "repository reachability not verifiable with repo-scoped GITHUB_TOKEN: ${repository_url}" >&2
    continue
  fi

  echo "organization repository link is not canonical or does not resolve: ${repository_url} (GitHub API HTTP ${status})" >&2
  failed=1
done

if (( failed != 0 )); then
  exit 1
fi

echo "validated ${#repository_urls[@]} ${organization} repository links and rejected legacy slugs"
